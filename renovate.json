{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump BYOND engine version in the Dockerfile and the published image tag",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.github/workflows/build-byond\\.yml$/"
      ],
      "matchStrings": [
        "ENV BYOND_VERSION=(?<currentValue>\\d+\\.\\d+)",
        "type=raw,value=(?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "custom.byond",
      "depNameTemplate": "byond-engine",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "byond": {
      "defaultRegistryUrlTemplate": "https://byond-builds.dm-lang.org/version.txt",
      "format": "plain"
    }
  }
}
